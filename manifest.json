{
  "manifest_version": 3,
  "name": "Tab Whitelist Monitor",
  "version": "1.0.0",
  "description": "Closes web tabs whose domains are not whitelisted.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}